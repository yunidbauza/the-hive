{
  "name": "the-hive",
  "private": true,
  "version": "0.7.1",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "//": "Since pnpm 10, dependency lifecycle scripts are blocked unless allowlisted — a supply-chain default, and the right one. Every entry here is a package granted arbitrary code execution at install time; the list stays minimal and every addition is justified in review. `electron` downloads its runtime binary (story 080); `node-pty` compiles its native addon (story 084). Without them, installs succeed and the app does not run.",
    "onlyBuiltDependencies": [
      "electron",
      "node-pty"
    ]
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run type-check && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/check-native-abi.mjs --fix",
    "rebuild:pty": "electron-rebuild --force --only node-pty",
    "check:abi": "node scripts/check-native-abi.mjs",
    "predesktop:dev": "node scripts/check-native-abi.mjs",
    "desktop:dev": "electron-vite dev",
    "desktop:build": "pnpm run type-check && electron-vite build",
    "desktop:preview": "electron-vite preview",
    "desktop:dist": "pnpm run desktop:build && electron-builder --mac --arm64 --publish never",
    "desktop:publish": "pnpm run desktop:build && electron-builder --mac --arm64 --publish always",
    "lint": "eslint .",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test --project=web",
    "test:e2e:electron": "PW_ELECTRON_ONLY=1 playwright test --project=electron",
    "test:pty": "electron-vite build && ELECTRON_RUN_AS_NODE=1 electron scripts/run-pty-conformance.mjs",
    "test:back": "HIVE_LIVE_BACK_PROOF=1 PW_ELECTRON_ONLY=1 playwright test --project=electron tests/e2e/electron/bare-back-claim.spec.ts",
    "test:hooks": "HIVE_LIVE_HOOK_PROOF=1 vitest run tests/live/hook-conformance.test.ts",
    "test:statusline": "HIVE_LIVE_STATUSLINE_PROOF=1 vitest run tests/live/statusline-conformance.test.ts",
    "test:skills": "HIVE_LIVE_SKILLS_PROOF=1 vitest run tests/live/skills-conformance.test.ts",
    "test:done": "HIVE_LIVE_DONE_PROOF=1 vitest run tests/live/done-conformance.test.ts",
    "test:ready": "HIVE_LIVE_READY_PROOF=1 vitest run tests/live/ready-conformance.test.ts",
    "test:title": "HIVE_LIVE_TITLE_PROOF=1 vitest run tests/live/title-conformance.test.ts",
    "test:kill": "HIVE_LIVE_KILL_PROOF=1 PW_ELECTRON_ONLY=1 playwright test --project=electron tests/e2e/electron/cmd-delete-line-kill.spec.ts",
    "test:ledger": "HIVE_LIVE_LEDGER_PROOF=1 vitest run tests/live/ledger-conformance.test.ts",
    "test:agent": "HIVE_LIVE_AGENT_PROOF=1 vitest run tests/live/agent-conformance.test.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "node-pty": "1.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
