{
  "compilerOptions": {
    "target": "ES2023",
    /* No DOM, deliberately (story 080). The main process has no window and no
       document; without this, a stray `document.querySelector` in main-process
       code type-checks cleanly and throws at runtime. The preload script does
       run in a renderer, but under `sandbox: true` its job is to call
       `contextBridge` and nothing else — it does not need DOM either. */
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode — electron-vite bundles both targets. */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "isolatedModules": true,

    /* Strictness — non-negotiable (story 010) */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,

    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./electron/shared/*"],
      /* The server half of server mode (HIVE-142). Mirrored in
         `vite.aliases.mjs` and the root `tsconfig.json`; this is the config
         that actually type-checks `electron/main/**`, which is where
         `@remote-host` is first imported (`ipc/index.ts`) — missing it here
         resolves in the editor (root `tsconfig.json` covers `src`/`tests`)
         and fails only `pnpm type-check`'s electron pass, per AGENTS.md's
         rule that an alias missing from either config resolves in the editor
         and fails at runtime. */
      "@remote-host/*": ["./electron/remote-host/*"]
    }
  },
  "include": ["electron"]
}
